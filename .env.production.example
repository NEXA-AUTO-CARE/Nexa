# ==============================================================================
# Nexa Production Environment & Secrets Strategy
# ==============================================================================
# In production, we do NOT use local `.env` files.
# Instead, values are resolved dynamically from AWS Secrets Manager,
# AWS Systems Manager (SSM) Parameter Store, or directly injected via
# ECS Fargate task definition environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Secrets Manager (Sensitive Variables - Securely Injected)
# ------------------------------------------------------------------------------
# These values are auto-generated or manually updated in AWS Secrets Manager.
# Injected into ECS container definitions using ecs.Secret.fromSecretsManager().

# Secrets Manager Secret: nexa/production/database-credentials
# Exposes JSON fields:
DATABASE_USER=nexa
DATABASE_PASSWORD=           # Securely generated at deployment time

# Secrets Manager Secret: nexa/production/jwt-access-secret
JWT_ACCESS_SECRET=           # High-entropy random key, generated at deployment time

# Secrets Manager Secret: nexa/production/jwt-refresh-secret
JWT_REFRESH_SECRET=          # High-entropy random key, generated at deployment time

# Secrets Manager Secret: nexa/production/stripe-secrets
STRIPE_SECRET=               # Stripe API Secret key (sk_live_...)
STRIPE_WEBHOOK_SECRET=       # Stripe Webhook verification key (whsec_...)

# Secrets Manager Secret: nexa/production/twilio-secrets
TWILIO_SID=                  # Twilio Account SID
TWILIO_TOKEN=                # Twilio Auth Token

# Secrets Manager Secret: nexa/production/smtp-secrets
SMTP_USER=                   # SMTP Authentication Username
SMTP_PASS=                   # SMTP Authentication Password


# ------------------------------------------------------------------------------
# 2. ECS Fargate Container Environment Variables (Static Config / Non-Sensitive)
# ------------------------------------------------------------------------------
# These values are statically defined in the CDK task definition or retrieved
# from SSM Parameter Store.

NODE_ENV=production
PORT=3000

# Database placement config
DATABASE_HOST=               # Injected dynamically from RDS Stack database endpoint output
DATABASE_PORT=5432
DATABASE_NAME=nexa

# AWS Native Storage config (replacing MinIO)
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_BUCKET=                   # Injected dynamically from S3 Stack bucket name output
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=false

# Notification parameters
AWS_SNS_REGION=us-east-1
AWS_SNS_TOPIC_ARN=           # Injected dynamically from SNS Stack topic ARN output
NOTIFICATION_SMS_PROVIDER=sns

# Application parameters
WEB_ORIGIN=                  # Injected from CloudFront distribution domain output
TWILIO_FROM=                 # Direct custom Twilio SMS source number (if twilio provider is active)
SMTP_HOST=                   # Outbound SMTP Mail server address
SMTP_PORT=587
SMTP_FROM=NEXA <noreply@nexa.app>
OTP_DEV_LOG=false
MOCK_PAYMENTS=false
SUPER_ADMIN_EMAIL=           # Admin promotion email on boot (bootstrap config)
