{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["jest", "node"]
  },
  "include": [
    "src/**/*.ts",
    "../../packages/shared/src/**/*.ts",
    "test/**/*.ts"
  ]
}
