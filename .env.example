# ============================================================================
# NEXA — Root environment template
# Copy this file to `.env` (root) and to `apps/api/.env` for the API,
# and to `apps/web/.env` for Vite (only VITE_* vars there).
# ============================================================================

# --- API: Database ---------------------------------------------------------
DATABASE_URL=postgresql://nexa:nexa@localhost:5432/nexa

# --- API: JWT --------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900           # 15 minutes (seconds)
JWT_REFRESH_TTL=2592000      # 30 days (seconds)

# --- API: S3 / MinIO -------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nexa-photos
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- API: Stripe (Sprint 4) ------------------------------------------------
STRIPE_SECRET=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- API: Twilio (Sprint 5) ------------------------------------------------
TWILIO_SID=AC_replace_me
TWILIO_TOKEN=replace_me
TWILIO_FROM=+441234567890

# --- API: Email (Sprint 5, e.g. Mailtrap locally) --------------------------
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=replace_me
SMTP_PASS=replace_me
SMTP_FROM="NEXA <noreply@nexa.test>"

# --- API: Misc -------------------------------------------------------------
WEB_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
OTP_DEV_LOG=true
MOCK_PAYMENTS=false

# --- Web: Vite (only VITE_* prefixed vars are exposed to the browser) ------
# Leave as `/api` to use the Vite dev-proxy (recommended for local dev).
# Or set to `http://localhost:3000/api` to bypass the proxy and call the API directly.
VITE_API_BASE_URL=/api
VITE_GOOGLE_MAPS_KEY=replace_me
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
